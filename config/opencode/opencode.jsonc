{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-openagent@latest"],
  "model": "litellm/high",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (starchips)",
      "options": {
        "baseURL": "http://100.123.54.73:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "coding": {
          "name": "LiteLLM: coding (deepseek-v4-flash)"
        },
        "normal": {
          "name": "LiteLLM: normal (deepseek-v4-flash)"
        },
        "high": {
          "name": "LiteLLM: high (kimi-k3)"
        },
        "cheap": {
          "name": "LiteLLM: cheap (qwen-3.7-flash)"
        },
        "multimodal": {
          "name": "LiteLLM: multimodal (qwen-3.7-flash)"
        }
      }
    }
  },
  "mcp": {
    "nixos": {
      "command": ["nix", "run", "github:utensils/mcp-nixos", "--"],
      "type": "local"
    }
  }
}
