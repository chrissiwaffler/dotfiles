{
  config,
  lib,
  pkgs,
  ...
}:
# Multi-user GPU sandbox for the desktop host.
#
# Colleagues SSH into an Ubuntu CUDA container (dedicated port) using their
# own Linux user accounts *inside* the container - they never get an account
# on the NixOS host itself. Inside they have a full Ubuntu 24.04 userland,
# CUDA toolkit and access to the NVIDIA GPU via CDI.
#
# Design:
# - Accounts + authorized keys are managed declaratively via
#   services.gpu-sandbox.users. Accounts have locked passwords; pubkey
#   auth only. Passwordless sudo inside the container.
# - Per-user home directories are bind-mounted from
#   /var/lib/gpu-sandbox/homes/<user> and survive container recreation.
# - The sshd host key lives in /var/lib/gpu-sandbox/ssh so colleagues
#   don't get host-key warnings after every `nixos-rebuild switch`.
# - GPU access uses hardware.nvidia-container-toolkit (CDI). The CDI spec
#   is generated into /var/run/cdi before docker.service starts.
# - Packages inside the container are installed via apt on container start
#   (with retries). Anything that must persist across rebuilds belongs
#   in $HOME (e.g. python venvs).
#
# Adding a colleague: add an entry under services.gpu-sandbox.users,
# then run `sudo nixos-rebuild switch --flake .#desktop` on the host.
with lib; let
  cfg = config.services.gpu-sandbox;

  # Unit generated by virtualisation.oci-containers (backend = "docker").
  containerUnit = "docker-${cfg.containerName}";

  defaultPackages = [
    "openssh-server"
    "sudo"
    "git"
    "curl"
    "wget"
    "vim"
    "tmux"
    "htop"
    "build-essential"
    "ca-certificates"
    "python3"
    "python3-pip"
    "python3-venv"
  ];

  # One idempotent setup block per sandbox user. Runs as root in the
  # container on every start; already-done work is cheap.
  mkUserBlock = name: u: ''
    # --- sandbox user: ${name} ---
    if ! getent passwd ${name} >/dev/null; then
      useradd -m ${optionalString (u.uid != null) "-u ${toString u.uid}"} \
        -s /bin/bash -c ${escapeShellArg u.description} ${name}
    else
      ${optionalString (u.uid != null) "usermod -u ${toString u.uid} ${name} 2>/dev/null || true"}
      usermod -s /bin/bash -c ${escapeShellArg u.description} ${name}
    fi
    usermod -aG sandboxusers,sudo,video ${name}
    echo "${name} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-gpu-sandbox-${name}
    chmod 440 /etc/sudoers.d/90-gpu-sandbox-${name}
    passwd -l ${name} >/dev/null 2>&1 || true # pubkey auth only
    # The home dir is a bind mount; skel may not have been copied on first
    # creation, so fill in missing dotfiles and fix ownership.
    cp -an /etc/skel/. /home/${name}/ 2>/dev/null || true
    chown ${name}:${name} /home/${name}
    install -d -m 700 -o ${name} -g ${name} /home/${name}/.ssh
    : > /home/${name}/.ssh/authorized_keys
    ${concatMapStringsSep "\n" (key: "echo ${escapeShellArg key} >> /home/${name}/.ssh/authorized_keys") u.keys}
    chown -R ${name}:${name} /home/${name}/.ssh
  '';

  # Runs as root inside the container on every start, then execs sshd.
  setupScript = pkgs.writeShellScript "gpu-sandbox-setup" ''
        set -eu

        export DEBIAN_FRONTEND=noninteractive

        # Fixed GID so file ownership is stable across container recreations.
        getent group sandboxusers >/dev/null || groupadd -g 2500 sandboxusers
        # Match the host video GID (26 on this box); belt and braces.
        getent group video >/dev/null || groupadd -g 26 video

        # --- users ---
        ${concatStringsSep "\n" (mapAttrsToList mkUserBlock cfg.users)}

        # --- apt packages (ephemeral layer, re-run after each recreation) ---
        apt_ok=0
        for attempt in 1 2 3; do
          if apt-get update -qq >/dev/null 2>&1 \
            && apt-get install -y -qq --no-install-recommends \
              ${concatStringsSep " " cfg.packages} >/dev/null 2>&1; then
            apt_ok=1
            break
          fi
          sleep 10
        done
        if [ "$apt_ok" != "1" ]; then
          echo "gpu-sandbox: apt install failed after retries, starting sshd anyway" >&2
        fi

        # --- sshd (host keys persisted via bind mount) ---
        install -d -m 755 /run/sshd
        install -d -m 700 /etc/ssh/hostkeys
        [ -f /etc/ssh/hostkeys/ssh_host_ed25519_key ] || ssh-keygen -q -t ed25519 -N "" -f /etc/ssh/hostkeys/ssh_host_ed25519_key
        [ -f /etc/ssh/hostkeys/ssh_host_ecdsa_key ] || ssh-keygen -q -t ecdsa -N "" -f /etc/ssh/hostkeys/ssh_host_ecdsa_key
        [ -f /etc/ssh/hostkeys/ssh_host_rsa_key ] || ssh-keygen -q -t rsa -N "" -f /etc/ssh/hostkeys/ssh_host_rsa_key
        cat > /etc/ssh/sshd_config.d/99-gpu-sandbox.conf <<'SSHD_CONF'
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PermitRootLogin no
    HostKey /etc/ssh/hostkeys/ssh_host_ed25519_key
    HostKey /etc/ssh/hostkeys/ssh_host_ecdsa_key
    HostKey /etc/ssh/hostkeys/ssh_host_rsa_key
    SSHD_CONF

        echo "gpu-sandbox: starting sshd on :22"
        exec /usr/sbin/sshd -D -e
  '';

  # Host-side dirs bind-mounted to per-user homes (one per configured user).
  homeVolumes =
    mapAttrsToList (
      name: _: "/var/lib/gpu-sandbox/homes/${name}:/home/${name}"
    )
    cfg.users;
in {
  options.services.gpu-sandbox = {
    enable = mkEnableOption "multi-user GPU sandbox container (Ubuntu CUDA)";

    port = mkOption {
      type = types.port;
      default = 2222;
      description = "Host port forwarded to sshd inside the sandbox";
    };

    containerName = mkOption {
      type = types.str;
      default = "gpu-sandbox";
      description = "Name of the OCI container (systemd unit: docker-<name>)";
    };

    image = mkOption {
      type = types.str;
      default = "nvidia/cuda:12.9.1-devel-ubuntu24.04";
      description = "Container image (CUDA devel stack on Ubuntu 24.04)";
    };

    packages = mkOption {
      type = types.listOf types.str;
      default = defaultPackages;
      description = "apt packages installed inside the container on every start";
    };

    users = mkOption {
      default = {};
      description = ''
        Colleague accounts inside the sandbox. Every entry needs at least
        one SSH public key; entries without keys cannot log in.
      '';
      example = {
        pancho.keys = ["ssh-ed25519 AAAA... pancho@example.com"];
      };
      type = types.attrsOf (types.submodule {
        options = {
          keys = mkOption {
            type = types.listOf types.str;
            default = [];
            description = "SSH public keys allowed to log in as this user";
          };
          description = mkOption {
            type = types.str;
            default = "";
            description = "GECOS field (full name)";
          };
          uid = mkOption {
            type = types.nullOr types.int;
            default = null;
            description = ''
              Fixed UID inside the container. Recommended so home-dir
              ownership stays stable when users are added over time.
            '';
          };
        };
      });
    };
  };

  config = mkIf cfg.enable {
    # CDI spec generation for the NVIDIA GPU: writes /var/run/cdi/*.json and
    # orders itself before docker.service (requiredBy). It also flips on
    # features.cdi in the docker daemon config (docker >= 25).
    hardware.nvidia-container-toolkit.enable = true;

    systemd.services.${containerUnit} = {
      after = ["nvidia-container-toolkit-cdi-generator.service"];
      wants = ["nvidia-container-toolkit-cdi-generator.service"];
    };

    virtualisation.oci-containers = {
      backend = "docker";
      containers.${cfg.containerName} = {
        inherit (cfg) image;
        autoStart = true;
        ports = ["${toString cfg.port}:22"];
        volumes =
          homeVolumes
          ++ [
            # persistent sshd host keys (no host-key warnings on rebuilds)
            "/var/lib/gpu-sandbox/ssh:/etc/ssh/hostkeys"
            # entrypoint script built on the host from the nix store
            "${setupScript}:/gpu-sandbox/setup.sh:ro"
            # match host timezone inside the container
            "/etc/localtime:/etc/localtime:ro"
          ];
        extraOptions = [
          "--hostname"
          "gpu-sandbox"
          # GPU via CDI (see hardware.nvidia-container-toolkit)
          "--device"
          "nvidia.com/gpu=all"
          # shared memory for pytorch dataloaders
          "--shm-size=8g"
          "--tmpfs=/run"
          "--tmpfs=/run/lock"
        ];
        # image has no entrypoint; default CMD is /bin/bash
        cmd = ["/bin/bash" "/gpu-sandbox/setup.sh"];
      };
    };

    # The sandbox ssh port is reachable from the LAN (Tailscale is trusted
    # anyway). Merges with the ports opened by tailscale.nix.
    networking.firewall.allowedTCPPorts = [cfg.port];
  };
}
